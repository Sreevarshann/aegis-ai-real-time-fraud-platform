# ---------------------------------------------------------------------------
# AEGIS AI - LOCAL DEVELOPMENT CONFIGURATION (NON-PRODUCTION)
# Copy to .env (make setup does this). These values are for a local demo only.
# Never reuse them anywhere real. .env is git-ignored.
# ---------------------------------------------------------------------------
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis-local-dev-password
POSTGRES_DB=aegis

# JWT signing secret for the local demo API. Generate your own with: openssl rand -hex 32
AEGIS_JWT_SECRET=nonprod-local-dev-only-replace-with-openssl-rand-hex-32

# Password assigned to every seeded demo user (admin@northwind.demo, analyst@northwind.demo, ...)
AEGIS_DEMO_USER_PASSWORD=AegisDemo!2026

# Live simulator speed. 1.0 = realistic per-customer rates (~2.8 events/s across 60k customers).
AEGIS_SIM_RATE_MULTIPLIER=1.0

# Optional local LLM (docker compose --profile llm). Leave false to use the deterministic engine.
AEGIS_OLLAMA_ENABLED=false
AEGIS_OLLAMA_MODEL=llama3.2:3b
# CPU inference for a 3B model takes ~30-90s per investigation on a laptop.
AEGIS_OLLAMA_TIMEOUT_S=180
